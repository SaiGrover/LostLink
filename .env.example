DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a private random key in production.
DJANGO_SECRET_KEY=
# Optional PostgreSQL connection; SQLite remains the local development default.
DATABASE_URL=
# Model defaults come from matching/profile.json (TF-IDF + ResNet).
# Use these overrides only for an explicitly lightweight demo:
# LOSTLINK_TEXT_MODEL=tfidf
# LOSTLINK_IMAGE_MODEL=histogram

# --- Accounts: campus identity and email ---------------------------------
# Comma-separated institutional email domains allowed to register (subdomains
# included), e.g. college.edu,alumni.college.edu. Empty = any domain, but
# every new account must still confirm its address by email.
LOSTLINK_ALLOWED_EMAIL_DOMAINS=
# Public base URL used in emailed links, e.g. https://lostlink.example.edu
LOSTLINK_PUBLIC_URL=
# Link lifetimes in seconds (defaults: 3 days / 1 hour).
# LOSTLINK_EMAIL_VERIFICATION_MAX_AGE=259200
# LOSTLINK_PASSWORD_RESET_TIMEOUT=3600
# Outgoing email (SMTP). With DJANGO_DEBUG=true and no host, emails print to
# the console. With DJANGO_DEBUG=false and no host, emails are NOT sent and an
# error is logged for each one (manage.py check warns: accounts.W001).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
# Keep the real password only in the deployment's secret store.
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=LostLink <no-reply@example.edu>
# Optional explicit backend (overrides the choice above), e.g.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
